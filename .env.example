# Run python scripts/setup.py for guided configuration. Never commit .env.
# Required: an existing Discord bot and a configured Seerr installation.
DISCORD_TOKEN=
ALLOWED_GUILD_IDS=
SEERR_URL=
SEERR_API_KEY=
# Optional browser-facing URL. Blank uses SEERR_URL.
SEERR_PUBLIC_URL=

# Timezone for new events and Life date/time input. Use an IANA timezone name.
TZ=UTC
# Optional per-feature overrides. Blank uses TZ.
EVENT_TIMEZONE=
LIFE_TIMEZONE=

# Optional providers. Leave both URL and key blank to disable a provider.
# Container localhost is not the Docker host. Use a LAN address or
# host.docker.internal for an API published on the Docker host.
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_PUBLIC_URL=
JELLYFIN_POLL_SECONDS=60
JELLYFIN_TASTE_USER=
SOULSYNC_URL=
SOULSYNC_API_KEY=
SOULSYNC_PUBLIC_URL=
SONARR_URL=
SONARR_API_KEY=

# Persistent files in the named Docker volume. Keep these paths for the
# portable Compose configuration, including its healthcheck.
DB_PATH=/app/data/mediabot.db
LOG_PATH=/app/data/mediabot.log
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=5
RUNTIME_HEALTH_PATH=/app/data/runtime-health.json
REQUEST_UI_TIMEOUT=300
EVENT_RECONCILE_SECONDS=60
EVENT_COMPLETION_GRACE_HOURS=6
# Optional role ID (or <@&ROLE_ID>) to ping. Requires exactly one allowed guild.
EVENT_REMINDER_MENTION=

# Owner-only raw Markdown capture; blank disables $think.
# This is local storage, not shared Life or a Nextcloud connection.
LIFE_CAPTURE_PATH=/app/data/life-inbox

# Advanced, separately provisioned gateway integrations. Disabled by default.
# Enabling a URL also requires the corresponding read-only token mount and
# container connectivity in your own Compose override. These gateway servers
# require explicit setup. See docs/AI.md and docs/REFERENCE.md#configuration-reference.
TORRENT_INTAKE_URL=
TORRENT_INTAKE_TOKEN_PATH=/run/secrets/torrent_intake_token
LIFE_GATEWAY_URL=
LIFE_GATEWAY_TOKEN_PATH=/run/secrets/life_gateway_token
NEXTCLOUD_PUBLIC_ORIGIN=
LOCAL_AI_URL=
LOCAL_AI_TOKEN_PATH=/run/secrets/local_ai_token

# Optional private SearXNG service, provisioned separately with deploy/web-search.
WEB_SEARCH_URL=
