DISCORD_TOKEN=
ALLOWED_GUILD_IDS=
SEERR_API_KEY=

SEERR_URL=http://host.docker.internal:5055
SEERR_PUBLIC_URL=https://requests.example.com

JELLYFIN_API_KEY=
JELLYFIN_URL=http://host.docker.internal:8096
JELLYFIN_PUBLIC_URL=https://media.example.com
JELLYFIN_POLL_SECONDS=60
JELLYFIN_TASTE_USER=

SOULSYNC_API_KEY=
SOULSYNC_URL=http://host.docker.internal:8008
SOULSYNC_PUBLIC_URL=

SONARR_API_KEY=
SONARR_URL=http://host.docker.internal:8989

DB_PATH=/app/data/mediabot.db
REQUEST_UI_TIMEOUT=300
EVENT_RECONCILE_SECONDS=60
EVENT_COMPLETION_GRACE_HOURS=6
# Optional role ID (or <@&ROLE_ID>) to ping. Requires exactly one allowed guild.
# Multi-guild deployments must leave this blank and send quiet reminders.
EVENT_REMINDER_MENTION=
LOG_PATH=/app/data/mediabot.log
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=5
RUNTIME_HEALTH_PATH=/app/data/runtime-health.json

# Owner-only private capture and torrent intake. The intake token is mounted as
# a Docker secret; never paste it into this file or Discord.
LIFE_CAPTURE_PATH=/life-vault/Life/Inbox
TORRENT_INTAKE_URL=http://torrent-intake:8765
TORRENT_INTAKE_TOKEN_PATH=/run/secrets/torrent_intake_token

# Separate owner-only Life and local text gateways. Credentials are separate
# read-only secret mounts. Nextcloud credentials never enter this container.
LIFE_GATEWAY_URL=http://life-gateway:8091
LIFE_GATEWAY_TOKEN_PATH=/run/secrets/life_gateway_token
LIFE_TIMEZONE=America/Denver
NEXTCLOUD_PUBLIC_ORIGIN=https://mediaserver.tail9c0ded.ts.net:8443
LOCAL_AI_URL=http://local-ai-gateway:8080
LOCAL_AI_TOKEN_PATH=/run/secrets/local_ai_token
